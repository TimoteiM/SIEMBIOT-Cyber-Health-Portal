{
  "realm": "siembiot",
  "enabled": true,
  "displayName": "SIEMBIOT (local)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "siembiot-web",
      "name": "SIEMBIOT web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
