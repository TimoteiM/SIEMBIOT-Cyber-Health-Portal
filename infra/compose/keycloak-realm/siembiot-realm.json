        "http://localhost:3000/api/v1/auth/callback",
        "http://127.0.0.1:3000/api/v1/auth/callback",
        "http://localhost:8000/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000"
