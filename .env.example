# Copy to .env for local-only development. Never commit populated values.
SIEMBIOT_ENV=development
# Where the browser reaches the interface. Also the **exact** Origin the API requires on
# every state change -- compared as a whole string, so scheme, host and port must all
# match what the browser actually sends.
#
# A mismatch fails in the worst available way: every read works and every write is
# refused with 403, which reads as a broken application rather than a wrong setting. The
# API logs `origin rejected: expected ... received ...` when it happens; that line is the
# fastest way to the answer.
#
# **The scheme differs between the two stacks**, and this is the mistake that is actually
# made. `make web-serve` runs `next dev --experimental-https`, so development is
# https://. The production-like stack has no TLS termination and serves plain http://.
# A value correct for one is wrong for the other.
SIEMBIOT_PUBLIC_BASE_URL=https://localhost:3000

# Host ports for the production-like stack. Both have defaults and neither needs setting,
# but a developer machine is allowed to already have something on 3000 or 8000, and
# fighting over a port is a worse first impression than one line of configuration.
# Changing SIEMBIOT_WEB_PORT means changing SIEMBIOT_PUBLIC_BASE_URL to match.
SIEMBIOT_WEB_PORT=3000
SIEMBIOT_API_PORT=8000
SIEMBIOT_API_BASE_URL=http://localhost:8000
SIEMBIOT_DATABASE_URL=postgresql+psycopg://siembiot_owner:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
SIEMBIOT_APP_DATABASE_URL=postgresql+psycopg://siembiot_app:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
# The worker connects as its own role. Migration 0009 lets that role write
# within one tenant without a human membership, which is why it must not share
# credentials with the API.
SIEMBIOT_WORKER_DATABASE_URL=postgresql+psycopg://siembiot_worker:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
# The only role that may delete evidence. Held apart from the worker deliberately:
# the worker can add evidence and cannot remove it, which is what makes a completed
# assessment trustworthy, and retention holds exactly the opposite pair.
SIEMBIOT_RETENTION_DATABASE_URL=postgresql+psycopg://siembiot_retention:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
SIEMBIOT_POSTGRES_DB=siembiot
SIEMBIOT_POSTGRES_OWNER_PASSWORD=CHANGEME_LOCAL_ONLY
SIEMBIOT_POSTGRES_APP_PASSWORD=CHANGEME_LOCAL_ONLY
SIEMBIOT_POSTGRES_WORKER_PASSWORD=CHANGEME_LOCAL_ONLY
# The observatory role. Serves only the published read model; see 0015.
SIEMBIOT_POSTGRES_PUBLIC_PASSWORD=CHANGE_ME_LOCAL_ONLY
# The retention role. It may delete expired evidence and may do nothing else -- a
# separate role rather than a flag on the worker, so "can remove data" is a credential
# somebody has to hand out. Required by the production-like stack.
SIEMBIOT_POSTGRES_RETENTION_PASSWORD=CHANGE_ME_LOCAL_ONLY
SIEMBIOT_REDIS_URL=redis://localhost:6379/0
SIEMBIOT_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Authentication terminates upstream and is owned by a separate team. The gateway
# proves it is the caller with this shared secret; without it the identity headers are
# ignored. Required outside development -- the API refuses to start without it.
SIEMBIOT_IDENTITY_GATEWAY_SECRET=
SIEMBIOT_DOMAIN_CHALLENGE_TTL_SECONDS=900
SIEMBIOT_DOMAIN_CHALLENGE_CREATE_LIMIT_PER_HOUR=3
SIEMBIOT_DOMAIN_REVERIFICATION_DAYS=30

# Local development identity. Authentication terminates upstream, so there is no
# gateway locally; the Next.js middleware injects these headers in development only.
# Leave SIEMBIOT_DEV_IDENTITY_SUBJECT empty to disable injection entirely.
SIEMBIOT_DEV_IDENTITY_ISSUER=https://idp.local.test
SIEMBIOT_DEV_IDENTITY_SUBJECT=
SIEMBIOT_DEV_IDENTITY_EMAIL=
SIEMBIOT_DEV_IDENTITY_NAME=""

# -- backups ------------------------------------------------------------------------
# Both are empty on purpose. The nightly task refuses to run rather than guessing, and
# reports which of these is missing; a default here would be a local path, and a backup
# on the same machine as the database survives a dropped table and nothing else.
#
# Where backups go. A directory on a separate filesystem, or s3://, gs://, azure://,
# sftp:// or nfs:// -- remote schemes are accepted as destinations, but the upload
# itself is the deployment's own tooling, and the task says so rather than pretending.
# A path sharing a filesystem with the PostgreSQL data directory is refused.
SIEMBIOT_BACKUP_DESTINATION=
# Credentials for the dump, and deliberately not the worker's. Every tenant-scoped table
# carries row-level security with FORCE, so a dump taken by a role subject to those
# policies would hold only the rows that role can see -- and restore without complaint.
# This must name siembiot_owner, or another role that can bypass row security.
SIEMBIOT_BACKUP_DATABASE_URL=
# Optional. When the data directory is visible from the worker, the destination is
# checked against it and refused if they share a device. Unset simply skips that check.
SIEMBIOT_POSTGRES_DATA_DIRECTORY=
