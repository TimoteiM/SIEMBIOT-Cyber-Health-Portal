# Copy to .env for local-only development. Never commit populated values.
SIEMBIOT_ENV=development
SIEMBIOT_PUBLIC_BASE_URL=https://localhost:3000
SIEMBIOT_API_BASE_URL=http://localhost:8000
SIEMBIOT_DATABASE_URL=postgresql+psycopg://siembiot_owner:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
SIEMBIOT_APP_DATABASE_URL=postgresql+psycopg://siembiot_app:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
# The worker connects as its own role. Migration 0009 lets that role write
# within one tenant without a human membership, which is why it must not share
# credentials with the API.
SIEMBIOT_WORKER_DATABASE_URL=postgresql+psycopg://siembiot_worker:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
# The only role that may delete evidence. Held apart from the worker deliberately:
# the worker can add evidence and cannot remove it, which is what makes a completed
# assessment trustworthy, and retention holds exactly the opposite pair.
SIEMBIOT_RETENTION_DATABASE_URL=postgresql+psycopg://siembiot_retention:CHANGEME_LOCAL_ONLY@127.0.0.1:5432/siembiot
SIEMBIOT_POSTGRES_DB=siembiot
SIEMBIOT_POSTGRES_OWNER_PASSWORD=CHANGEME_LOCAL_ONLY
SIEMBIOT_POSTGRES_APP_PASSWORD=CHANGEME_LOCAL_ONLY
SIEMBIOT_POSTGRES_WORKER_PASSWORD=CHANGEME_LOCAL_ONLY
# The observatory role. Serves only the published read model; see 0015.
SIEMBIOT_POSTGRES_PUBLIC_PASSWORD=CHANGE_ME_LOCAL_ONLY
SIEMBIOT_REDIS_URL=redis://localhost:6379/0
SIEMBIOT_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# Authentication terminates upstream and is owned by a separate team. The gateway
# proves it is the caller with this shared secret; without it the identity headers are
# ignored. Required outside development -- the API refuses to start without it.
SIEMBIOT_IDENTITY_GATEWAY_SECRET=
SIEMBIOT_DOMAIN_CHALLENGE_TTL_SECONDS=900
SIEMBIOT_DOMAIN_CHALLENGE_CREATE_LIMIT_PER_HOUR=3
SIEMBIOT_DOMAIN_REVERIFICATION_DAYS=30
SIEMBIOT_MODEL_PROVIDER=disabled

# Local development identity. Authentication terminates upstream, so there is no
# gateway locally; the Next.js middleware injects these headers in development only.
# Leave SIEMBIOT_DEV_IDENTITY_SUBJECT empty to disable injection entirely.
SIEMBIOT_DEV_IDENTITY_ISSUER=https://idp.local.test
SIEMBIOT_DEV_IDENTITY_SUBJECT=
SIEMBIOT_DEV_IDENTITY_EMAIL=
SIEMBIOT_DEV_IDENTITY_NAME=""
