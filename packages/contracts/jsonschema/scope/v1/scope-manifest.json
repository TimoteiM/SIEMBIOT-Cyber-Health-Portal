{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/contracts/scope/v1/scope-manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "authorization_id", "organization_id", "actor", "targets", "policy_version", "consent", "valid_from", "valid_until", "issued_at"],
  "properties": {
    "manifest_version": {"const": "v1"},
    "authorization_id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"const": "user"},
        "id": {"type": "string", "format": "uuid"}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 400,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain_id", "canonical_host", "operation_class"],
        "properties": {
          "domain_id": {"type": "string", "format": "uuid"},
          "canonical_host": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$", "maxLength": 253},
          "operation_class": {"enum": ["dns_verification", "https_verification", "passive_assessment", "active_assessment"]}
        }
      }
    },
    "policy_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "text", "sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "text": {"type": "string", "minLength": 20, "maxLength": 10000},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
