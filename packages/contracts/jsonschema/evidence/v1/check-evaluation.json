{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/contracts/evidence/v1/check-evaluation.json",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "evaluation_id", "organization_id", "asset_id", "check_id", "policy_hash", "methodology_version", "scoring_behavior_version", "mode", "outcome", "evidence_ids", "reason_code", "evaluated_at", "source_confidence", "attribution_confidence", "fresh", "directly_attributable", "provider_disagreement", "publishable"],
  "properties": {
    "contract_version": {"const": "v1"}, "evaluation_id": {"type": "string", "pattern": "^sha256-v1:[a-f0-9]{64}$"},
    "organization_id": {"type": "string", "format": "uuid"}, "asset_id": {"type": "string", "format": "uuid"},
    "check_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}, "policy_hash": {"type": "string", "pattern": "^sha256-v1:[a-f0-9]{64}$"},
    "methodology_version": {"type": "string"}, "scoring_behavior_version": {"type": "string"}, "mode": {"enum": ["fixture", "live"]},
    "outcome": {"enum": ["pass", "fail", "warning", "unknown", "error", "not_applicable", "suppressed", "accepted_risk"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^sha256-v1:[a-f0-9]{64}$"}, "uniqueItems": true},
    "reason_code": {"type": "string"}, "evaluated_at": {"type": "string", "format": "date-time"},
    "source_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "attribution_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "fresh": {"type": "boolean"}, "directly_attributable": {"type": "boolean"}, "provider_disagreement": {"type": "boolean"}, "publishable": {"type": "boolean"}
  }
}
