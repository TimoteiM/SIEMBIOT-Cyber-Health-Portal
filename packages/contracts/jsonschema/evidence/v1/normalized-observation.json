{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/contracts/evidence/v1/normalized-observation.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "canonicalization_version", "hash_version", "normalized_id", "organization_id", "asset_id", "scope_reference", "source_evidence_id", "observation_type", "source_outcome", "observed_at", "mode", "provenance", "payload", "source_confidence", "attribution_confidence", "freshness_seconds", "publishable", "real_world"],
  "properties": {
    "contract_version": {"const": "v1"},
    "canonicalization_version": {"const": "canonical-json-v1"},
    "hash_version": {"const": "sha256-v1"},
    "normalized_id": {"type": "string", "pattern": "^sha256-v1:[a-f0-9]{64}$"},
    "organization_id": {"type": "string", "format": "uuid"},
    "asset_id": {"type": "string", "format": "uuid"},
    "scope_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_evidence_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "observation_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
    "source_outcome": {"enum": ["pass", "fail", "warning", "unknown", "error", "unavailable", "disabled_by_policy"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "mode": {"const": "fixture"},
    "provenance": {"type": "object", "additionalProperties": false,
      "required": ["collector_id", "collector_version", "adapter_id", "adapter_version", "normalizer_version", "scenario_id", "scenario_sha256"],
      "properties": {"collector_id": {"type": "string"}, "collector_version": {"type": "string"}, "adapter_id": {"type": "string"}, "adapter_version": {"type": "string"}, "normalizer_version": {"type": "string"}, "scenario_id": {"type": ["string", "null"]}, "scenario_sha256": {"type": ["string", "null"]}}
    },
    "payload": {"type": "object"},
    "source_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "attribution_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "freshness_seconds": {"type": "integer", "minimum": 0},
    "publishable": {"const": false},
    "real_world": {"const": false}
  }
}
