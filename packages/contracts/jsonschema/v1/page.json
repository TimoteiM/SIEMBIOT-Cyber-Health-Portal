{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.siembiot.example/v1/page.json",
  "title": "PageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "items", "page"],
  "properties": {
    "contract_version": { "const": "v1" },
    "items": { "type": "array" },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "next_cursor"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "next_cursor": { "type": ["string", "null"], "maxLength": 512 }
      }
    }
  }
}
