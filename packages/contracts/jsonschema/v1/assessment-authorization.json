{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/contracts/v1/assessment-authorization.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "organization_id", "state", "policy_version", "consent_version", "valid_from", "valid_until", "operation_classes"],
  "properties": {
    "contract_version": {"const": "v1"},
    "id": {"type": "string", "format": "uuid"},
    "organization_id": {"type": "string", "format": "uuid"},
    "state": {"enum": ["draft", "active", "expired", "revoked"]},
    "policy_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "consent_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "operation_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["dns_verification", "https_verification", "passive_assessment", "active_assessment"]}}
  }
}
