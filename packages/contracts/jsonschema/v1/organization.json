{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.siembiot.example/v1/organization.json",
  "title": "OrganizationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "name", "slug", "created_at"],
  "properties": {
    "contract_version": { "const": "v1" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
