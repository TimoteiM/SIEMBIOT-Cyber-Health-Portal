{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/contracts/collection/v1/observation.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "evidence_id", "scope_reference", "collector", "adapter", "collected_at", "execution_mode", "scenario", "classification", "outcome", "confidence", "freshness_seconds", "publishable", "real_world", "payload"],
  "properties": {
    "contract_version": {"const": "v1"},
    "evidence_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope_reference": {"type": "string", "minLength": 1, "maxLength": 256},
    "collector": {"$ref": "#/$defs/component"},
    "adapter": {"$ref": "#/$defs/component"},
    "collected_at": {"type": "string", "format": "date-time"},
    "execution_mode": {"const": "fixture"},
    "scenario": {"$ref": "#/$defs/scenario"},
    "classification": {"enum": ["public_metadata", "private_metadata", "sensitive"]},
    "outcome": {"enum": ["pass", "fail", "warning", "unknown", "error", "unavailable", "disabled_by_policy"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "freshness_seconds": {"type": "integer", "minimum": 0},
    "publishable": {"const": false},
    "real_world": {"const": false},
    "payload": {"type": "object"}
  },
  "$defs": {
    "component": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    }
  }
}
