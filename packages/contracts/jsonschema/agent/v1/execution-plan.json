{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/contracts/agent/v1/execution-plan.json",
  "title": "ExecutionPlan",
  "description": "What the model intends to do, declared before it does any of it, so the gateway can refuse a plan rather than discover its intent one tool call at a time. A plan is a proposal: approving it grants nothing that the scope did not already allow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "run_id", "steps"],
  "properties": {
    "contract_version": {"const": "v1"},
    "run_id": {"type": "string", "format": "uuid"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "purpose"],
        "properties": {
          "tool": {
            "enum": [
              "read_findings",
              "read_evaluations",
              "read_observation",
              "read_remediation_template",
              "read_knowledge_base"
            ]
          },
          "purpose": {"type": "string", "maxLength": 500}
        }
      }
    }
  }
}
