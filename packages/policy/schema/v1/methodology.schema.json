{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siembiot.example/policy/schema/v1/methodology.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "methodology_version", "scoring_behavior_version", "minimum_coverage", "pillars"],
  "properties": {
    "schema_version": {"const": "v1"},
    "methodology_version": {"type": "string"},
    "scoring_behavior_version": {"type": "string"},
    "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 100},
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight"],
        "properties": {
          "id": {"type": "string"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    }
  }
}
